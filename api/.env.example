# Copy this file to ".env" on the machine that runs the API and fill in the real values.
# Never commit the real .env file.
DB_HOST=
DB_PORT=5432
DB_NAME=peoplehub_pricing
DB_USER=
DB_PASSWORD=
DB_SSL=false

# Long random string used to sign login sessions
SESSION_SECRET=
PORT=4400

# Set to true once the site is served over HTTPS (marks the login cookie Secure)
COOKIE_SECURE=false

# Proposal emails via Plunk. The sender must be on a domain verified in Plunk.
PLUNK_SECRET_KEY=
PLUNK_FROM=proposals@hrynex.com
PLUNK_FROM_NAME=Victory Information

# Public address of this site. Used in emailed links (proposals, password reset). Must be the real public URL once deployed.
APP_BASE_URL=http://localhost:4400
# Domain name only, no https:// (used by the production compose file for the HTTPS certificate)
APP_DOMAIN=

# SMS alerts through Dialog eSMS (leave blank to switch SMS off)
ESMS_KEY=
ESMS_USERNAME=
ESMS_PASSWORD=
ESMS_MASK=
ESMS_PAYMENT=0

# WhatsApp alerts (official WhatsApp Business Cloud API). Leave blank to switch off.
WA_TOKEN=EAANcKStnJZAsBS2CStAgaz55RZA9OZAFkGmvnZCDvKMtU6KUt1RsLASllJL0qFkwHGjQ53dxpM2eZAIZAnRfTrZCDfNb6CXwdj7waNxMOC44IiUYIHuaq9DHrz8ierZBFvWEwYzBiuq9ZA40xbKsaZBPdmVqMvgUNNGI83ugy8Y1p5bmg2OewDuZB3fUvoYWdedWx1mkd9DP8BZCiVlyHWNMPuC0a4cVM94AZC2X5kbRJlLLYWJuZBo4giKl5ZCarO4Lbk8SJjv2IjtRRK65TMndeJ2NtbAV3Sj
WA_PHONE_ID=1379705911900843
WA_TEMPLATE=peoplehub_alert
WA_LANG=en

# Phone push alerts through ntfy (the defaults are fine; leave NTFY_TOKEN blank for the public server)
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# Optional: pin the app image version for the production compose file (default is the latest image)
APP_IMAGE=
